# Copie para deploy/.env. Use valores do MESMO Supabase (cloud ou self-hosted).
# URL HTTPS pública: usada pelo navegador e pelo backend.
SUPABASE_URL=https://supabase.provedor.com.br
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
LINKCE_DOMAIN=sistema.provedor.com.br
ALLOWED_ORIGINS=https://sistema.provedor.com.br
# Segredos aleatórios diferentes, com pelo menos 32 caracteres. Não reutilize senhas.
AUTH_RATE_LIMIT_SECRET=
API_RATE_LIMIT_SECRET=
DEFAULT_EMPRESA_ID=00000000-0000-0000-0000-000000000001
# Marcador operacional. A conexão efetiva é definida pelas variáveis SUPABASE_*.
LINKCE_DEPLOYMENT_MODE=servidor_proprio
