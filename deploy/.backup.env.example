# Copie para um arquivo privado fora do Git e use uma conta exclusiva de backup.
# Guarde a senha em ~/.pgpass (chmod 600); ela não aparece nos argumentos do processo.
BACKUP_PGHOST=127.0.0.1
BACKUP_PGPORT=5432
BACKUP_PGDATABASE=postgres
BACKUP_PGUSER=backup_operator
BACKUP_DIR=/var/backups/sistema-campo
BACKUP_RETENTION_DAYS=14
# Destino rclone opcional, já configurado no servidor (ex.: remoto:backups/sistema).
BACKUP_RCLONE_REMOTE=
